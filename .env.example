# InstantRCcard — environment settings
# Copy this file to .env and fill the real values, then run: npm start

# Port for the Node server (default 4173)
PORT=4173

# RC provider API (server side only — never expose the token in the browser)
RC_API_URL=https://api.apnirc.xyz/api/b2b/get-rc
RC_API_TOKEN=put_your_provider_token_here

# Mobile number that becomes the admin account (10 digits, no +91)
# Create/signup with this same mobile number to get the admin role.
ADMIN_MOBILE=

# Fixed secret so login sessions survive server restarts (any long random string)
SESSION_SECRET=change_this_to_a_long_random_string

# Optional Google Sheet mirror (Apps Script /exec URL + the same secret on both sides)
SHEET_WEBHOOK_URL=
SHEET_SYNC_SECRET=

# Optional: public rating shown on the website (single digit like 4.9)
PUBLIC_RATING=

# Optional: custom path for the JSON database file
# DB_FILE=./data/instant-rccard.json
