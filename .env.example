# InstantRCcard server environment (copy to .env and fill the values)

# Port used by the Node server
PORT=4173

# RC provider API (token stays on the server only)
RC_API_URL=https://api.apnirc.xyz/api/b2b/get-rc
RC_API_TOKEN=

# 10-digit mobile number that becomes the admin account
ADMIN_MOBILE=

# Fixed secret so the login cookie keeps working after a restart/redeploy
SESSION_SECRET=

# Optional durable Google Sheet mirror
SHEET_WEBHOOK_URL=
SHEET_SYNC_SECRET=

# Optional custom JSON store path (defaults to data/instant-rccard.json)
DB_FILE=

# Optional fallback homepage rating
PUBLIC_RATING=

# --- SEO / Google Search Console ---
# Canonical site origin used in sitemap.xml, robots.txt, canonical/Open Graph tags and structured data.
# Defaults to https://instantrccard.in when empty.
SITE_URL=

# Google Search Console "HTML tag" verification: paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools (msvalidate.01) verification value, optional.
BING_SITE_VERIFICATION=

# Set to 1 to 301-redirect other public hostnames (e.g. *.up.railway.app, www.) to SITE_URL.
CANONICAL_REDIRECT=
