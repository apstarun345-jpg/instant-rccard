# ============================================================
# InstantRCcard — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill real values.
#
# SECURITY:
#   - Never commit a real `.env` to git (already in .gitignore below).
#   - Rotate SESSION_SECRET regularly and after any suspected leak.
#   - Rotate RC_API_TOKEN if it has ever been exposed in client
#     code, screenshots, logs or shared chats.
#   - ADMIN_MOBILE must be set BEFORE creating the admin account.
#   - The Node server only listens to its own network — the only
#     secret that leaves the box at runtime is RC_API_TOKEN, sent
#     in the Authorization header to api.apnirc.xyz.
# ============================================================

# --- Server ---
PORT=4173

# --- RC Provider (api.apnirc.xyz) -----------------------------
# Get from your RC API provider dashboard. Treat like a password.
RC_API_URL=https://api.apnirc.xyz/api/b2b/get-rc
RC_API_TOKEN=replace-with-real-provider-token

# --- Session cookie HMAC --------------------------------------
# 64-char hex (32 random bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keeping this FIXED in Render makes existing cookies survive
# restarts. Changing it logs every user out at once.
SESSION_SECRET=replace-with-64-char-hex

# --- Admin bootstrap ------------------------------------------
# 10-digit Indian mobile number. The account created with this
# number is auto-promoted to the admin role on signup or login.
ADMIN_MOBILE=9999999999

# --- Google Sheet mirror (optional, durable backup) -----------
# Apps Script /exec URL. Both secrets below must match the
# Apps Script Code.gs values.
SHEET_WEBHOOK_URL=
SHEET_SYNC_SECRET=

# --- Storage --------------------------------------------------
DB_FILE=data/instant-rccard.json

# --- Public stats (optional override) -------------------------
# Defaults: users baseline 200000, downloads baseline 171000,
# rating 4.9, RC Card price 15. Admin can change these from UI.
PUBLIC_RATING=

# ============================================================
# Recommended: production hardening
# ============================================================
# Set to 1 to ENABLE stricter rate limits (recommended on Render).
ENABLE_STRICT_RATE_LIMITS=1
# How many failed logins before lockout (per mobile+IP per hour).
LOGIN_LOCKOUT_THRESHOLD=8
# Lockout window in seconds.
LOGIN_LOCKOUT_WINDOW=3600
# CSRF token TTL in seconds (default 12h).
CSRF_TTL=43200
# Trusted proxy IPs (comma separated). Set to "" to disable.
TRUSTED_PROXIES=
# A pre-shared secret the frontend must echo in X-Client-Secret
# header for sensitive mutating endpoints (signup/login/admin).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLIENT_SHARED_SECRET=
