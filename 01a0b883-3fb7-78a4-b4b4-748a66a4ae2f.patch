new file mode 100644
index 0000000..92e1891
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,55 @@
+# InstantRCcard server environment (copy to .env and fill the values)
+
+# Port used by the Node server
+PORT=4173
+
+# RC provider API (token stays on the server only)
+RC_API_URL=https://api.apnirc.xyz/api/b2b/get-rc
+RC_API_TOKEN=
+
+# 10-digit mobile number that becomes the admin account
+ADMIN_MOBILE=
+
+# Fixed secret so the login cookie keeps working after a restart/redeploy
+SESSION_SECRET=
+
+# Optional durable Google Sheet mirror
+SHEET_WEBHOOK_URL=
+SHEET_SYNC_SECRET=
+
+# Optional custom JSON store path (defaults to data/instant-rccard.json)
+DB_FILE=
+
+# Optional fallback homepage rating
+PUBLIC_RATING=
+
+# ============================================================
+# SECURITY (added in PR #3)
+# ============================================================
+# Set to "production" to enable fatal-startup validation that
+# refuses to boot without RC_API_TOKEN, SESSION_SECRET and
+# ADMIN_MOBILE.
+NODE_ENV=
+
+# Set to 1 to tighten rate-limit buckets (recommended on Render).
+#   0 (default): 600 global, 30 auth, 10 rc, 120 admin /min/IP
+#   1 (strict):  240 global, 10 auth,  3 rc,  30 admin /min/IP
+ENABLE_STRICT_RATE_LIMITS=0
+
+# Login brute-force lockout: threshold failures inside the
+# window will lock the account (per mobile + per IP) for the
+# window duration. Defaults to 20 (8 in strict mode).
+LOGIN_LOCKOUT_THRESHOLD=20
+LOGIN_LOCKOUT_WINDOW=3600
+
+# CSRF cookie TTL in seconds (default 12h).
+CSRF_TTL=43200
+
+# Optional pre-shared client secret. If set, every /api/*
+# request must echo this value in X-Client-Secret header.
+# Generate with:
+#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
+CLIENT_SHARED_SECRET=
+
+# Comma-separated IPs allowed to set X-Forwarded-For (empty = use socket IP).
+TRUSTED_PROXIES=
